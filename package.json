{
  "name": "agentOS",
  "private": true,
  "version": "1.0.0",
  "description": "Collaborative AI Operating System for Software Engineering",
  "license": "MIT",
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">= 24.15.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm --workspace @agentos/web run dev",
    "dev:api": "npm --workspace @agentos/api run dev",
    "db:generate": "npm --workspace @agentos/api exec drizzle-kit generate",
    "db:push": "npm --workspace @agentos/api exec drizzle-kit push",
    "db:studio": "npm --workspace @agentos/api exec drizzle-kit studio",
    "build": "echo \"Workspace is not configured yet\"",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "echo \"Workspace is not configured yet\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  }
}
